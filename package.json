{
  "name": "evo",
  "version": "2.0.0",
  "description": "Evo — a VSCode-like IDE running in the browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "server": "npm run build:server && node dist-server/index.js",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@xterm/addon-fit": "^0.11.0",
    "monaco-editor": "^0.50.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "xterm": "^5.3.0"
  }
}
